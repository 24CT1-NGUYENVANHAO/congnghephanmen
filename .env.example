# =============================================================================
#  CẤU HÌNH MÔI TRƯỜNG - SáchGóc Uni
#
#  Sao chép file này thành `.env` rồi chỉnh cho khớp máy:
#      cp .env.example .env          (Windows: copy .env.example .env)
#
#  ⚠️  KHÔNG cần tạo file này cũng chạy được. Nếu không kết nối được MySQL,
#  hệ thống sẽ TỰ ĐỘNG dùng SQLite và in cảnh báo giải thích cách khắc phục.
# =============================================================================

# --- Django ---
DEBUG=True

# Danh sách host được phép truy cập (phân tách bằng dấu phẩy)
ALLOWED_HOSTS=127.0.0.1,localhost

# Sinh khoá mới cho riêng bạn:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=doi-khoa-nay-voi-khoa-ngau-nhien-32-ky-tu-toi-thieu

# -----------------------------------------------------------------------------
#  CƠ SỞ DỮ LIỆU
# -----------------------------------------------------------------------------
# Dự án dùng MySQL làm CSDL chính. Cần tạo database trước:
#
#   CREATE DATABASE sachgocuni_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# Cổng MySQL thay đổi tuỳ máy — xem trong XAMPP Control Panel, cột "Port(s)":
#   - XAMPP mặc định               : 3306
#   - XAMPP (khi đã có MySQL khác) : 3307
#   - MySQL cài riêng               : 3306
#
# Nếu không kết nối được, hệ thống tự chuyển sang SQLite và vẫn chạy bình thường.
#

# Đặt True để ép dùng SQLite (không cần cài MySQL)
USE_SQLITE=False

DB_NAME=sachgocuni_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Upload ảnh ---
# Kích thước tối đa mỗi ảnh (bằng byte). 5MB = 5 * 1024 * 1024
MAX_UPLOAD_SIZE=5242880

# --- Giao diện ---
# Số bài đăng trên mỗi trang
POSTS_PER_PAGE=12
