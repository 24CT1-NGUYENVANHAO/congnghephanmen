# ============================================================
#  CẤU HÌNH MÔI TRƯỜNG - SáchGóc Uni
#  Sao chép file này thành `.env` rồi chỉnh sửa theo máy của bạn.
#  Lệnh:  cp .env.example .env   (Windows: copy .env.example .env)
# ============================================================

# --- Django ---
# Sinh khóa bảo mật mới:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-doi-voi-ban-voi-khoa-ngau-nhien-32-ky-tu-toi-thieu
DEBUG=True

# Danh sách host được phép truy cập (phân tách bằng dấu phẩy)
# Ở chế độ DEBUG=True, Django tự cho phép localhost/127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Cơ sở dữ liệu ---
# Đặt USE_SQLITE=True nếu bạn KHÔNG bật XAMPP/MySQL (dùng SQLite cho dễ chạy)
USE_SQLITE=False

DB_NAME=sachgocuni_db
DB_USER=root
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Upload ảnh ---
# Kích thước tối đa mỗi ảnh (bằng byte). 5MB = 5 * 1024 * 1024
MAX_UPLOAD_SIZE=5242880

# Số bài đăng trên mỗi trang
POSTS_PER_PAGE=12
