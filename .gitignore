# ============================================================
#  .gitignore - SáchGóc Uni
# ============================================================

# --- Byte-compiled / Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Django ---
*.log
local_settings.py
*.sqlite3
db.sqlite3
db.sqlite3-journal

# --- Cấu hình môi trường ---
# .env KHÔNG commit vì có thể chứa mật khẩu MySQL thật.
# Thầy/cô clone về chạy:  cp .env.example .env
#
# Dự án TỰ ĐỘNG chuyển sang SQLite nếu không kết nối được MySQL,
# nên thiếu file .env vẫn chạy được.
.env
.env.local
!.env.example


# --- File upload của người dùng ---
media/posts/*
media/avatars/*
!media/posts/.gitkeep
!media/avatars/.gitkeep

# --- Static files đã build ---
staticfiles/

# --- Môi trường Python ---
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- IDE / Editor ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Tài liệu kế hoạch nội bộ (KHÔNG dùng trong bài nộp) ---
ARCHITECTURE.md
SEQUENCE_DIAGRAMS.md
contact_sheet.jpg
